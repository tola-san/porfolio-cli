{
  "name": "@tolalumina/create-portfolio",
  "version": "1.0.2",
  "description": "Create a polished, reusable developer portfolio in seconds.",
  "type": "module",
  "bin": {
    "create-portfolio": "./bin/cli.js"
  },
  "files": [
